POSTGRES_USER=fitboddy
POSTGRES_PASSWORD=fitboddy_local_dev
POSTGRES_DEFAULT_DB=fitboddy
REDIS_PASSWORD=redis_local_dev

JWT_SECRET=auth_service_dev_secret_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=10080

# Root MinIO. Только сервер и minio-init. Не отдавать сервисам.
S3_ACCESS_KEY=fitboddy_s3
S3_SECRET_KEY=fitboddy_s3_local_dev
S3_BUCKET=fitboddy-media

# profile-service: чтение и запись только префикса avatars/
S3_PROFILE_ACCESS_KEY=fitboddy_profile
S3_PROFILE_SECRET_KEY=fitboddy_profile_local_dev

# plan-service: чтение, запись и удаление только photos/ и videos/
S3_PLAN_ACCESS_KEY=fitboddy_plan
S3_PLAN_SECRET_KEY=fitboddy_plan_local_dev

# Обязателен для короткоживущих URL фото в plan-service.
# В любом общем или продовом окружении замените placeholder, например: openssl rand -hex 32
MEDIA_URL_SIGNING_SECRET=change_me_media_url_signing_secret
# Срок жизни подписанного URL фото, в секундах.
MEDIA_URL_TTL_SECONDS=300

INTERNAL_SERVICE_TOKEN=fitboddy_internal_dev

# Уведомления о тренировках. Пустой TELEGRAM_BOT_TOKEN: воркер запущен, сообщения не шлёт.
# NOTIFICATIONS_SCHEDULER_ENABLED в compose задан явно: true только у plan-notifications-worker, false у API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
NOTIFICATIONS_DEFAULT_TIMEZONE=Asia/Vladivostok
NOTIFICATIONS_MORNING_REMINDER=09:00
NOTIFICATIONS_REMINDER_LEAD_MINUTES=120
NOTIFICATIONS_PLAN_DEBOUNCE_SECONDS=900
NOTIFICATIONS_PLAN_NOTICE_TTL_SECONDS=604800
NOTIFICATIONS_MISSED_LOOKBACK_DAYS=2
NOTIFICATIONS_POLL_SECONDS=60
NOTIFICATIONS_LINK_CODE_TTL_SECONDS=900

HTTP_TIMEOUT_SECONDS=5
REQUIRE_PROFILE_COMPLETION=true
MARKETPLACE_PROFILE_SYNC_ENABLED=true

GHCR_OWNER=your-github-org-or-user
IMAGE_TAG=latest

PLATFORM_ADMIN_LOGIN=platform_admin
PLATFORM_ADMIN_PASSWORD=change_me_platform_admin
PLATFORM_ADMIN_EMAIL=admin@fitboddy.dev
