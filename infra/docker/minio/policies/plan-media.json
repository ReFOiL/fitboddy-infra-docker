{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::__BUCKET__"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::__BUCKET__"],
      "Condition": {
        "Null": {
          "s3:prefix": ["true"]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::__BUCKET__"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["photos/*", "videos/*"]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/photos/*",
        "arn:aws:s3:::__BUCKET__/videos/*"
      ]
    }
  ]
}
